local _s = table.concat(_chunks)

local function _getLoad()
	local candidates = {
		loadstring,
		load,
		rawget(_G, "loadstring"),
		rawget(_G, "load"),
	}
	pcall(function()
		if getrenv then
			local r = getrenv()
			table.insert(candidates, r.loadstring)
			table.insert(candidates, r.load)
		end
	end)
	pcall(function()
		if getgenv then
			local g = getgenv()
			table.insert(candidates, g.loadstring)
			table.insert(candidates, g.load)
		end
	end)
	for _, f in ipairs(candidates) do
		if type(f) == "function" then return f end
	end
	return nil
end

local _ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local _map = {}
for i = 1, #_ALPH do _map[string.byte(_ALPH, i)] = i - 1 end

local function _decode(data)
	local out = {}
	local n = 0
	local buf, bits = 0, 0
	for i = 1, #data do
		local b = string.byte(data, i)
		if b == 61 then -- =
			break
		end
		local v = _map[b]
		if v then
			buf = buf * 64 + v
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				n = n + 1
				out[n] = string.char(math.floor(buf / (2 ^ bits)) % 256)
				buf = buf % (2 ^ bits)
			end
		end
	end
	return table.concat(out)
end

local okDec, src = pcall(_decode, _s)
if not okDec or type(src) ~= "string" or #src < 100 then
	error("Phantom failed to decode (b64): " .. tostring(src), 0)
end

local loaderFn = _getLoad()
if not loaderFn then
	error("Phantom failed to decode: no loadstring/load in this executor", 0)
end

local fn, err = loaderFn(src)
if not fn then
	error("Phantom failed to decode (compile): " .. tostring(err), 0)
end

local okRun, runErr = pcall(fn)
if not okRun then
	error("Phantom runtime error: " .. tostring(runErr), 0)
end
