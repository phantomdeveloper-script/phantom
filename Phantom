local function boot(src)
	if type(src) ~= "string" or #src < 64 then return false end
	local loader = loadstring or load
	if type(loader) ~= "function" then
		pcall(function()
			if getrenv then loader = getrenv().loadstring or getrenv().load end
		end)
	end
	if type(loader) ~= "function" then
		pcall(function()
			if getgenv then loader = getgenv().loadstring or getgenv().load end
		end)
	end
	if type(loader) ~= "function" then
		error("Phantom: no loadstring", 0)
	end
	local fn, err = loader(src)
	if not fn then
		error("Phantom compile: " .. tostring(err), 0)
	end
	fn()
	return true
end

local names = {
	"Phantom_Deobfuscated.lua",
	"Phantom_Plain.lua",
	"Phantom.lua",
	"phantom.lua",
}

local src
for _, name in ipairs(names) do
	pcall(function()
		if type(readfile) == "function" then
			src = readfile(name)
		end
	end)
	if type(src) == "string" and #src > 64 then break end
	pcall(function()
		if isfile and isfile(name) and readfile then
			src = readfile(name)
		end
	end)
	if type(src) == "string" and #src > 64 then break end
end

if type(src) ~= "string" or #src < 64 then
	local url = "https://raw.githubusercontent.com/phantomdeveloper-script/phantom/refs/heads/main/Phantom"
	pcall(function()
		src = game:HttpGet(url)
	end)
	if type(src) ~= "string" or #src < 64 then
		pcall(function()
			local req = (syn and syn.request) or http_request or request
			if req then
				local r = req({ Url = url, Method = "GET" })
				if r then src = r.Body end
			end
		end)
	end
end

if type(src) ~= "string" or #src < 64 then
	error("Phantom: execute Phantom_Deobfuscated.lua directly (base64 pack returns next turn).", 0)
end

boot(src)
