local function run(src)
	local loader = loadstring or load
	if type(loader) ~= "function" then
		pcall(function()
			if getrenv then loader = getrenv().loadstring or getrenv().load end
		end)
	end
	if type(loader) ~= "function" then
		pcall(function()
			if getgenv then loader = getgenv().loadstring or getgenv().load end
		end)
	end
	if type(loader) ~= "function" then
		msg("no loadstring on this executor")
		return
	end
	local fn, err = loader(src)
	if not fn then
		msg("compile fail: " .. tostring(err))
		return
	end
	local ok, e2 = pcall(fn)
	if not ok then
		msg("runtime: " .. tostring(e2))
	end
end

